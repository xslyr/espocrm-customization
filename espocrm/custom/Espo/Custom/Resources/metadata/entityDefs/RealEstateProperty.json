        "cSuite": {
            "type": "int",
            "isCustom": true
        },
        "cVagasdegaragem": {
            "type": "int",
            "isCustom": true
        },
        "cUrlwp": {
            "type": "url",
            "isCustom": true,
            "readOnly": false,
            "inlineEditDisabled": true
        },
        "cCapa": {
            "type": "image",
            "previewSize": "small",
            "maxFileSize": 2,
            "isCustom": true
        },
        "cStatuswp": {
            "type": "enum",
            "options": [
                "Rascunho",
                "Publicado"
            ],
            "style": {
                "Rascunho": null,
                "Publicado": null
            },
            "default": "Rascunho",
            "maxLength": 100,
            "isCustom": true
        },
        "cLatitude": {
            "type": "varchar",
            "maxLength": 20,
            "options": [],
            "isCustom": true,
            "required": true
        },
        "cLongitude": {
            "type": "varchar",
            "maxLength": 20,
            "options": [],
            "isCustom": true,
            "required": true
        },
        "cTitlewp": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true,
            "required": true
        },
        "cUrlGdrive": {
            "type": "url",
            "readOnly": false,
            "isCustom": true,
            "inlineEditDisabled": true
        },
        "cLarguraComprimento": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "tooltip": true,
            "isCustom": true
        },
        "cRecordId": {
            "type": "varchar",
            "maxLength": 100,
            "readOnlyAfterCreate": false,
            "options": [],
            "isCustom": true,
            "inlineEditDisabled": true,
            "readOnly": true,
            "copyToClipboard": true
        },
        "addressState": {
            "default": "SP"
        }
    },
    "links": {
        "images": {
            "type": "hasChildren",
            "entity": "Attachment",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true,
            "relationName": "attachments",
            "utility": true
        },
        "cCondominium": {
            "type": "belongsTo",
            "foreign": "realEstateProperties",
            "entity": "CCondominium",
            "audited": false,
            "isCustom": true
        },
        "cCapa": {
            "type": "belongsTo",
            "entity": "Attachment",
            "skipOrmDefs": true,
            "utility": true
        }
    }
