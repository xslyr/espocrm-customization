{
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "addressCity",
            "addressStreet",
            "cDescricao",
            "cTitlewp",
            "cAddressNeighbor"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "optimisticConcurrencyControl": false,
    "fields": {
        "images": {
            "sourceList": [],
            "accept": [],
            "maxFileSize": 2
        },
        "type": {
            "default": "Separate House",
            "style": {
                "Apartment": null,
                "Separate House": null,
                "Land Lot": null,
                "Farm": null,
                "Office": null,
                "Room": null,
                "Warehouse": null,
                "Retail": null
