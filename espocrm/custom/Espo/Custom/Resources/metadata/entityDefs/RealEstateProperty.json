                "Apartment",
                "Separate House",
                "Land Lot",
                "Farm",
                "Office",
                "Room",
                "Warehouse",
                "Retail"
            ]
        },
        "streamUpdatedAt": {
            "minuteStep": 30
        },
        "status": {
            "style": {
                "New": null,
                "Assigned": null,
                "In Process": null,
                "Completed": "success",
                "Canceled": "danger",
                "Lost": "danger"
            }
        },
        "requestType": {
            "default": "Sale",
