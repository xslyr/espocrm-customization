{
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "addressCity",
            "addressStreet",
            "cDescricao",
            "cTitlewp",
            "cAddressNeighbor"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "optimisticConcurrencyControl": false,
    "fields": {
        "images": {
            "sourceList": [],
            "accept": [],
            "maxFileSize": 2
        },
        "type": {
            "default": "Apartment",
            "style": {
                "Apartment": null,
                "Separate House": null,
                "Land Lot": null,
                "Farm": null,
                "Office": null,
                "Room": null,
                "Warehouse": null,
                "Retail": null
            },
            "options": [
                "Apartment",
                "Separate House",
                "Land Lot",
                "Farm",
                "Office",
                "Room",
                "Warehouse",
                "Retail"
            ],
            "required": true
        },
        "streamUpdatedAt": {
            "minuteStep": 30
        },
        "status": {
            "style": {
                "New": "success",
                "Assigned": "warning",
                "In Process": "warning",
                "Completed": "primary",
                "Canceled": "danger",
                "Lost": "danger"
            }
        },
        "requestType": {
            "default": "Sale",
            "optionsReference": "RealEstateRequest.type"
        },
        "floor": {
            "default": 0,
            "min": 0,
            "isMatching": true
        },
        "priceCurrency": {
            "default": "BRL"
        },
        "cAddressNeighbor": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true,
            "required": true
        },
        "cDescricao": {
            "type": "wysiwyg",
            "height": 300,
            "minHeight": 200,
            "isCustom": true,
            "required": true
        },
        "cCondominium": {
            "type": "link"
        },
        "cAdicionais": {
            "type": "multiEnum",
            "storeArrayValues": true,
            "default": [],
            "options": [
                "Alarme",
