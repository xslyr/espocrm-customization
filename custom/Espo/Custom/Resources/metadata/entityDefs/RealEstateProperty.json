                "Energia Trifásica": null,
                "Fechadura Eletrônica": null,
                "Galpão/Celeiro": null,
                "Gerador de Energia": null,
                "Horta": null,
                "Interfone": null,
                "Internet(Fibra ou Satélite)": null,
                "Jacuzi": null,
                "Jardim/Paisagismo": null,
                "Lago/Açude": null,
                "Lavabo": null,
                "Móveis Planejados": null,
                "Painéis Solares": null,
                "Piscina": null,
                "Playground Infantil": null,
                "Poço Artesiano": null,
                "Pomar": null,
                "Portão Eletrônico": null,
                "Quadra de Tênis/Beach Tennis": null,
                "Quadra Poliesportiva": null,
