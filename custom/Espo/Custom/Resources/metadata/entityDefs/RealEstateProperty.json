            "isCustom": true,
            "isSorted": true
        },
        "cConsolidadoadicionais": {
            "type": "multiEnum",
            "storeArrayValues": true,
            "default": [],
            "isSorted": true,
            "style": [],
            "isCustom": true
        },
        "addressCountry": {
            "default": "Brasil"
        },
        "cUsefulsquare": {
            "notNull": false,
            "type": "float",
            "isCustom": true,
            "isMatching": true
        },
        "cIdwp": {
            "type": "int",
            "isCustom": true,
            "disableFormatting": true,
            "inlineEditDisabled": true,
            "readOnly": false
        },
        "cUrlgooglemaps": {
            "type": "url",
            "isCustom": true
        },
        "cUrlvideo": {
            "type": "url",
            "isCustom": true
        },
        "cSuite": {
            "type": "int",
            "isCustom": true,
            "isMatching": true
        },
        "cVagasdegaragem": {
            "type": "int",
            "isCustom": true,
            "isMatching": true
        },
        "cUrlwp": {
            "type": "url",
            "isCustom": true,
            "readOnly": false,
            "inlineEditDisabled": true
        },
        "cStatuswp": {
            "type": "enum",
            "options": [
                "Rascunho",
                "Publicado"
            ],
            "style": {
                "Rascunho": "danger",
                "Publicado": "success"
            },
            "default": "Rascunho",
            "maxLength": 100,
            "isCustom": true
        },
        "cLatitude": {
            "type": "varchar",
            "maxLength": 20,
            "options": [],
            "isCustom": true,
            "required": true
        },
        "cLongitude": {
            "type": "varchar",
            "maxLength": 20,
            "options": [],
            "isCustom": true,
            "required": true
        },
        "cTitlewp": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true,
            "required": true
        },
        "cUrlGdrive": {
            "type": "url",
            "readOnly": false,
            "isCustom": true,
            "inlineEditDisabled": true
        },
        "cLarguraComprimento": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "tooltip": true,
            "isCustom": true
        },
        "cRecordId": {
            "type": "varchar",
            "maxLength": 100,
            "readOnlyAfterCreate": false,
            "options": [],
            "isCustom": true,
            "inlineEditDisabled": true,
            "readOnly": true,
            "copyToClipboard": true
        },
        "addressState": {
            "default": "SP",
            "required": false
        },
        "bedroomCount": {
            "isMatching": true
        },
        "bathroomCount": {
            "isMatching": true
        },
        "floorCount": {
            "isMatching": true
        },
        "yearBuilt": {
            "isMatching": true
        },
        "square": {
            "isMatching": true
        },
        "price": {
            "required": true
        },
        "addressCity": {
            "required": false
        },
        "cCityLink": {
            "type": "link",
            "required": true
        },
        "cMesclarComImovelExistente": {
            "notNull": true,
            "type": "bool",
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "cPermuta": {
            "type": "multiEnum",
            "storeArrayValues": true,
            "default": [],
            "options": [
                "carros",
                "motos",
                "lancha",
                "jet ski",
                "casas",
                "apartamentos",
                "terrenos",
                "chácaras/sítios"
            ],
            "style": {
                "carros": null,
                "motos": null,
                "lancha": null,
                "jet ski": null,
                "casas": null,
                "apartamentos": null,
                "terrenos": null,
                "chácaras/sítios": null
            },
            "isCustom": true
        },
        "name": {
            "options": []
        }
    },
    "links": {
        "images": {
            "type": "hasChildren",
            "entity": "Attachment",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true,
            "relationName": "attachments",
            "utility": true
        },
        "cCondominium": {
            "type": "belongsTo",
            "foreign": "realEstateProperties",
            "entity": "CCondominium",
            "audited": false,
            "isCustom": true
        },
        "requests": {
            "audited": false
        },
        "cCityLink": {
            "type": "belongsTo",
            "foreign": "realEstateProperties",
            "entity": "CCity",
            "audited": false,
            "isCustom": true
        }
    },
    "propertyTypes": {
        "Apartment": {
            "fieldList": [
                "bedroomCount",
                "bathroomCount",
                "floor",
                "floorCount",
                "yearBuilt",
                "square",
                "cSuite",
                "cVagasdegaragem"
            ]
        },
        "Separate House": {
            "fieldList": [
                "bedroomCount",
                "bathroomCount",
                "floorCount",
                "yearBuilt",
                "square",
                "cUsefulsquare",
                "cVagasdegaragem",
                "cSuite"
            ]
        },
        "Land Lot": {
            "fieldList": [
                "square"
            ]
        },
        "Farm": {
            "fieldList": [
                "yearBuilt",
                "square",
                "bedroomCount",
                "bathroomCount",
                "cUsefulsquare",
                "cSuite"
            ]
        },
        "Office": {
            "fieldList": [
                "floor",
                "floorCount",
                "yearBuilt",
                "square",
                "bedroomCount",
                "bathroomCount",
                "cVagasdegaragem"
            ]
        },
        "Room": {
            "fieldList": [
                "floor",
                "yearBuilt",
                "square",
                "bedroomCount",
                "bathroomCount"
            ]
        },
        "Warehouse": {
            "fieldList": [
                "yearBuilt",
                "square",
                "bedroomCount",
                "bathroomCount"
            ]
        },
        "Retail": {
            "fieldList": [
                "yearBuilt",
                "square",
                "cVagasdegaragem",
                "bedroomCount",
                "bathroomCount"
            ]
        }
    }
}