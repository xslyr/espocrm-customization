                "PR",
                "RJ",
                "RN",
                "RO",
                "RR",
                "RS",
                "SC",
                "SE",
                "SP",
                "TO"
            ],
            "style": {
                "AC": null,
                "AL": null,
                "AM": null,
                "AP": null,
                "BA": null,
                "CE": null,
                "DF": null,
                "ES": null,
                "GO": null,
                "MA": null,
                "MG": null,
                "MS": null,
                "MT": null,
                "PA": null,
                "PB": null,
                "PE": null,
                "PI": null,
                "PR": null,
                "RJ": null,
                "RN": null,
                "RO": null,
                "RR": null,
                "RS": null,
                "SC": null,
                "SE": null,
                "SP": null,
                "TO": null
            },
            "default": "SP",
            "maxLength": 100,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "realEstateProperties": {
            "type": "hasMany",
            "foreign": "cCityLink",
            "entity": "RealEstateProperty",
            "audited": false,
            "isCustom": true
        },
        "condominiums": {
            "type": "hasMany",
            "foreign": "cCityLink",
            "entity": "CCondominium",
            "audited": false,
            "isCustom": true
        },
        "realEstateRequests": {
            "type": "hasMany",
            "foreign": "cCityLink",
            "entity": "RealEstateRequest",
            "audited": false,
            "isCustom": true
        },
        "contacts": {
            "type": "hasMany",
            "foreign": "cCityLink",
            "entity": "Contact",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false
}